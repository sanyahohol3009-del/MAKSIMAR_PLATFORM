#!/usr/bin/env sh
set -eu

echo "===== PRE-PUSH: MAKSIMAR STAGE GUARD ====="
./.venv/bin/python tools/git_stage_guard.py --staged --worktree-summary

if [ "${MAKSIMAR_PRE_PUSH_FULL_AUTO:-0}" = "1" ]; then
  echo "===== PRE-PUSH: FULL AUTO ENABLED ====="
  ./.venv/bin/python -m pytest -n auto --dist=loadfile --import-mode=importlib -q --tb=short
fi

if [ "${MAKSIMAR_PRE_PUSH_PYTEST_TARGETS:-}" != "" ]; then
  echo "===== PRE-PUSH: CUSTOM PYTEST TARGETS ====="
  ./.venv/bin/python -m pytest ${MAKSIMAR_PRE_PUSH_PYTEST_TARGETS} -q --tb=short
fi
