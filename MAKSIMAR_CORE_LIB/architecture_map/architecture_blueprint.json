{
  "schema_version": "1.0",
  "blueprint_id": "MAKSIMAR_PLATFORM_FULL_CONSOLIDATED_SKELETON_vFINAL_FREEZE",
  "project_name": "MAKSIMAR_PLATFORM",
  "purpose": "Canonical architecture blueprint for Architecture Radar, Semantic Drift Guard, Structure Guard and Containerization Readiness checks.",
  "core_laws": [
    "No direct cube-to-cube coupling.",
    "No UI-to-execution direct path.",
    "No dashboard-to-action direct path.",
    "No product-to-CORE_ROOT direct import.",
    "No runtime-to-canonical-write path.",
    "No external backend may import or mutate core/runtime/supervisor directly.",
    "All risky actions must pass proposal, sandbox, validation, diff, approval and audit.",
    "Dashboard is read-only display and intent surface only.",
    "Memory retrieval must pass policy, tenant and jurisdiction boundaries.",
    "Physical/robotics execution must pass simulation and strict validation first."
  ],
  "enforcement": {
    "fail_on_forbidden_import": true,
    "fail_on_unknown_local_import": true,
    "fail_on_unregistered_source_file": true,
    "fail_on_missing_mandatory_paths": true,
    "fail_on_container_missing_for_ready_layers": false,
    "allow_external_imports": true,
    "scan_tests_for_import_drift": false,
    "scan_external_backends_for_import_drift": false
  },
  "ignored_path_globs": [
    ".git/**",
    ".venv/**",
    "venv/**",
    "__pycache__/**",
    ".pytest_cache/**",
    ".mypy_cache/**",
    ".ruff_cache/**",
    ".pymon/**",
    "node_modules/**",
    "dist/**",
    "build/**",
    "*.egg-info/**",
    "EXTERNAL_BACKENDS/**/.git/**",
    "EXTERNAL_BACKENDS/**/.venv/**",
    "EXTERNAL_BACKENDS/**/venv/**",
    "EXTERNAL_BACKENDS/**/sandbox_data/**",
    "EXTERNAL_BACKENDS/**/__pycache__/**"
  ],
  "allowed_unmapped_file_globs": [
    "setup.py",
    "conftest.py"
  ],
  "containerization": {
    "purpose": "Read-only readiness radar. It reports missing container markers but does not fail by default.",
    "ready_markers": [
      "container_contract.yaml",
      "container_contract.yml",
      "Dockerfile",
      ".dockerignore"
    ],
    "recommended_markers_by_profile": {
      "core_library": [
        "container_contract.yaml"
      ],
      "server_service": [
        "container_contract.yaml",
        "Dockerfile",
        ".dockerignore"
      ],
      "worker_service": [
        "container_contract.yaml",
        "Dockerfile",
        ".dockerignore"
      ],
      "product_cube": [
        "module_manifest.yaml",
        "container_contract.yaml",
        "Dockerfile",
        ".dockerignore"
      ],
      "external_backend": [
        "vendor_security_report.json",
        "container_contract.yaml"
      ],
      "docs_or_tests": []
    }
  },
