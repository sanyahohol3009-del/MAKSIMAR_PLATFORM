{
  "schema_version": "capability_manifest.v2",
  "id": "conversation.respond",
  "version": "2.0.0",
  "purpose": "Grounded natural conversation through the canonical Final Brain",
  "description": "User-visible JARVIS reply for conversation/social exchange; consumes upstream EvidenceBundle; no evidence tools.",
  "public_operations": ["respond"],
  "operation_contracts": [
    {
      "operation_id": "respond",
      "description": "Produce a user-visible JARVIS reply from identity, context and supplied evidence.",
      "required_parameters": [],
      "evidence_kinds": ["identity_facts", "bounded_session_context"],
      "effect_type": "OBSERVE",
      "target_scope": "bounded_same_identity_session",
      "reversibility": "REVERSIBLE",
      "external_side_effect": false,
      "risk_class": "READ_ONLY"
    }
  ],
  "input_schema": "request_understanding.v2+bounded_session_context.v2",
  "output_schema": "evidence_bundle.v1",
  "risk_class": "READ_ONLY",
  "permissions": ["conversation.respond"],
  "provider": "existing_jarvis_final_brain",
  "healthcheck": "ConversationPort.health",
  "timeout_policy": {"operation_seconds": 8.0},
  "network_policy": "DENY",
  "filesystem_policy": "READ_ONLY",
  "exclusions": ["project tools", "filesystem mutation", "canonical memory write"],
  "degradation_state": "conversation_continues",
  "examples": ["semantic conversation with bounded follow-up context"],
  "non_examples": ["project inspection", "PC action execution", "memory mutation"]
}
