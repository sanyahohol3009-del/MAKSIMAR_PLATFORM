registry_version: 1
status_model:
  - active_canonical
  - draft
  - superseded
  - historical_only

document_types:
  - canonical
  - audit_closure
  - continuity_history
  - draft

authority_levels:
  - constitutional
  - operational
  - reference
  - historical

interpretation_priorities:
  - strict
  - high
  - medium
  - historical

packages:
