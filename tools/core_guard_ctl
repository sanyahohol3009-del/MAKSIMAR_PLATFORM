#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/MAKSIMAR_PLATFORM"
SESSION_NAME="maksimar_core_guard"
LOG_FILE="$ROOT/logs/core_guard.log"
PID_FILE="$ROOT/RUNTIME/core_guard.pid"
HEARTBEAT_FILE="$ROOT/RUNTIME/state/core_guard_heartbeat_state.json"

HEARTBEAT_TIMEOUT_SEC=12

STATE_WARMING_UP="WARMING_UP"
STATE_ALIVE="ALIVE"
STATE_DEAD="DEAD"
STATE_BROKEN="BROKEN"

log() {
  echo "[core_guard_ctl] $1"
}

session_exists() {
  tmux has-session -t "$SESSION_NAME" 2>/dev/null
}

find_pid() {
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 - "$PID_FILE" <<'PY'
import sys
from pathlib import Path
from CORE_ROOT.heartbeat_io import find_owned_module_process_pid
pid = find_owned_module_process_pid("CORE_ROOT.core_guard", pidfile=Path(sys.argv[1]))
if pid is not None:
    print(pid)
PY
}
process_exists() {
  local pid
  pid="$(find_pid || true)"
  [[ -n "${pid:-}" ]]
}

heartbeat_age() {
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 - "$HEARTBEAT_FILE" <<'PY'
import sys
from pathlib import Path
from CORE_ROOT.heartbeat_io import safe_read_json, heartbeat_age_seconds
path = Path(sys.argv[1])
if not path.exists():
    print("missing")
else:
    age = heartbeat_age_seconds(safe_read_json(path))
    print("invalid" if age is None else f"{age:.2f}")
PY
}
heartbeat_is_fresh() {
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 - "$HEARTBEAT_FILE" "$HEARTBEAT_TIMEOUT_SEC" <<'PY'
import sys
from CORE_ROOT.heartbeat_io import (
    safe_read_json, heartbeat_age_seconds, heartbeat_source,
    heartbeat_status, heartbeat_process_alive,
)
payload = safe_read_json(sys.argv[1])
age = heartbeat_age_seconds(payload)
valid = (payload is not None and age is not None and age <= float(sys.argv[2])
         and heartbeat_status(payload) == "alive"
         and heartbeat_source(payload) == "core_guard"
         and heartbeat_process_alive(payload, "CORE_ROOT.core_guard"))
raise SystemExit(0 if valid else 1)
PY
}
truth() {
  session_exists && process_exists && heartbeat_is_fresh
}

normalized_state() {
  local has_session="0"
  local has_process="0"
  local hb_age=""

  if session_exists; then
    has_session="1"
  fi

  if process_exists; then
    has_process="1"
  fi

  hb_age="$(heartbeat_age)"

  if truth; then
    printf '%s\n' "$STATE_ALIVE"
    return 0
  fi

  if [[ "$hb_age" == "missing" ]]; then
    if [[ "$has_session" == "1" || "$has_process" == "1" ]]; then
      printf '%s\n' "$STATE_WARMING_UP"
      return 0
    fi
    printf '%s\n' "$STATE_DEAD"
    return 0
  fi

  if [[ "$hb_age" == "invalid" ]]; then
    printf '%s\n' "$STATE_BROKEN"
    return 0
  fi

  if [[ "$has_session" == "1" && "$has_process" == "1" ]]; then
    printf '%s\n' "$STATE_DEAD"
    return 0
  fi

  if [[ "$has_session" == "1" || "$has_process" == "1" ]]; then
    printf '%s\n' "$STATE_BROKEN"
    return 0
  fi

  printf '%s\n' "$STATE_DEAD"
}

write_pid_file() {
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 - "$PID_FILE" "CORE_ROOT.core_guard" <<'PY'
import sys
from CORE_ROOT.heartbeat_io import write_owned_pid_hint
write_owned_pid_hint(sys.argv[1], sys.argv[2])
PY
}

remove_pid_file() {
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 - "$PID_FILE" "CORE_ROOT.core_guard" <<'PY'
import sys
from CORE_ROOT.heartbeat_io import remove_stopped_pid_hint
remove_stopped_pid_hint(sys.argv[1])
PY
}

start() {
  if truth; then
    log "already running (truthful)"
    status
    return 0
  fi

  if session_exists; then
    log "existing guard session has no proven healthy owner; refusing replacement"
    return 1
  fi

  remove_pid_file
  mkdir -p "$ROOT/RUNTIME" "$ROOT/RUNTIME/state" "$(dirname "$LOG_FILE")"

  log "starting core guard tmux session: $SESSION_NAME"
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 - "$SESSION_NAME" "$ROOT" "cd '$ROOT' && python3 -m CORE_ROOT.core_guard 2>&1 | tee -a '$LOG_FILE'" <<'PY'
import os, subprocess, sys
from CORE_ROOT.run_context import runtime_mutation
env = dict(os.environ)
env.pop("MAKSIMAR_STARTUP_FD", None)
with runtime_mutation():
    subprocess.run(["tmux", "new-session", "-d", "-s", sys.argv[1], "-c", sys.argv[2]], check=True, close_fds=True, env=env)
    subprocess.run(["tmux", "send-keys", "-t", sys.argv[1], sys.argv[3], "C-m"], check=True, close_fds=True, env=env)
PY

  sleep 2
  write_pid_file

  if truth; then
    log "started ($SESSION_NAME)"
    return 0
  fi

  log "started tmux session, but core guard is not yet truthful"
  status
  return 1
}

stop() {
  log "stopping..."

  if session_exists; then
    tmux kill-session -t "$SESSION_NAME" 2>/dev/null || true
  fi

  local pid
  pid="$(find_pid || true)"
  if [[ -n "${pid:-}" ]]; then
    kill "$pid" 2>/dev/null || true
    sleep 1
  fi

  pid="$(find_pid || true)"
  if [[ -n "${pid:-}" ]]; then
    kill -9 "$pid" 2>/dev/null || true
  fi

  remove_pid_file
  log "done"
}

status() {
  if session_exists; then
    log "tmux:"
    echo "  RUNNING (session: $SESSION_NAME)"
  else
    log "tmux:"
    echo "  STOPPED"
  fi

  local pid
  pid="$(find_pid || true)"
  if [[ -n "${pid:-}" ]]; then
    log "process:"
    echo "  RUNNING (pid=$pid, module=CORE_ROOT.core_guard)"
  else
    log "process:"
    echo "  STOPPED"
  fi

  log "heartbeat:"
  if [[ ! -f "$HEARTBEAT_FILE" ]]; then
    echo "  missing"
  else
    local age
    age="$(heartbeat_age)"
    if [[ "$age" == "missing" || "$age" == "invalid" ]]; then
      echo "  $age"
    else
      if heartbeat_is_fresh; then
        echo "  FRESH (age=${age}s, file=$HEARTBEAT_FILE)"
      else
        echo "  STALE (age=${age}s, file=$HEARTBEAT_FILE)"
      fi
    fi
  fi

  log "state:"
  echo "  $(normalized_state)"

  log "truth:"
  if truth; then
    echo "  ALIVE"
  else
    echo "  NOT_ALIVE"
  fi
}

attach() {
  if ! session_exists; then
    log "no session: $SESSION_NAME"
    return 1
  fi
  tmux attach -t "$SESSION_NAME"
}

usage() {
  echo "Usage: ./tools/core_guard_ctl {start|stop|status|attach}"
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    start) start ;;
    stop) stop ;;
    status) status ;;
    attach) attach ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
