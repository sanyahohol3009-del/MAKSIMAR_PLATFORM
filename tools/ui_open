#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/MAKSIMAR_PLATFORM"
DASHBOARD_SESSION="maksimar_dashboard"
OOB_SESSION="maksimar_oob"
DASHBOARD_OWNERSHIP_FILE="$ROOT/RUNTIME/state/dashboard_session_ownership.env"
WINDOW_ID="JARVIS_RUNTIME_DASHBOARDS"

log() {
  echo "[ui_open] $1"
}

session_exists() {
  local session_name="$1"
  tmux has-session -t "$session_name" 2>/dev/null
}

main() {
  if [[ -n "${TMUX:-}" ]]; then
    log "inside tmux; skip ui open"
    exit 0
  fi

  if [[ -z "${WSL_DISTRO_NAME:-}" ]]; then
    log "WSL_DISTRO_NAME missing; skip ui open"
    exit 0
  fi

  if ! command -v cmd.exe >/dev/null 2>&1; then
    log "cmd.exe missing; skip ui open"
    exit 0
  fi

  if ! session_exists "$DASHBOARD_SESSION"; then
    log "runtime dashboard session missing: $DASHBOARD_SESSION"
    exit 0
  fi

  if ! session_exists "$OOB_SESSION"; then
    log "oob session missing: $OOB_SESSION"
    exit 0
  fi

  if [[ ! -f "$DASHBOARD_OWNERSHIP_FILE" ]] \
    || ! grep -qx "tmux_session=$DASHBOARD_SESSION" "$DASHBOARD_OWNERSHIP_FILE"; then
    log "dashboard ownership metadata missing; skip ui open"
    exit 0
  fi

  log "opening registered JARVIS dashboard window"

  cmd.exe /c wt.exe -w "$WINDOW_ID" \
    new-tab --title JARVIS-Dashboard wsl.exe -d "$WSL_DISTRO_NAME" --cd "$ROOT" --exec tmux attach -t "$DASHBOARD_SESSION:dashboard" \
    ';' \
    new-tab --title JARVIS-OOB wsl.exe -d "$WSL_DISTRO_NAME" --cd "$ROOT" --exec tmux attach -t "$OOB_SESSION" \
    >/dev/null 2>&1 || true
}

main "$@"
