#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/MAKSIMAR_PLATFORM"
OPERATOR_SESSION="maksimar_operator"
OOB_SESSION="maksimar_oob"

log() {
  echo "[ui_open] $1"
}

session_exists() {
  local session_name="$1"
  tmux has-session -t "$session_name" 2>/dev/null
}

main() {
  if [[ -n "${TMUX:-}" ]]; then
    log "inside tmux; skip ui open"
    exit 0
  fi

  if [[ -z "${WSL_DISTRO_NAME:-}" ]]; then
    log "WSL_DISTRO_NAME missing; skip ui open"
    exit 0
  fi

  if ! command -v cmd.exe >/dev/null 2>&1; then
    log "cmd.exe missing; skip ui open"
    exit 0
  fi

  if ! session_exists "$OPERATOR_SESSION"; then
    log "operator session missing: $OPERATOR_SESSION"
    exit 0
  fi

  if ! session_exists "$OOB_SESSION"; then
    log "oob session missing: $OOB_SESSION"
    exit 0
  fi

  log "opening Windows Terminal tabs"

  cmd.exe /c wt.exe -w 0 \
    new-tab --title Dashboard wsl.exe -d "$WSL_DISTRO_NAME" bash -lc "cd '$ROOT' && tmux attach -t '$OPERATOR_SESSION:dashboard'" \
    ';' \
    new-tab --title OOB wsl.exe -d "$WSL_DISTRO_NAME" bash -lc "cd '$ROOT' && tmux attach -t '$OOB_SESSION'" \
    ';' \
    new-tab --title "Command Console" wsl.exe -d "$WSL_DISTRO_NAME" bash -lc "cd '$ROOT' && source .venv/bin/activate && exec bash" \
    >/dev/null 2>&1 || true
}

main "$@"
