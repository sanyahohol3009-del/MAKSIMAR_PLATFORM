#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/MAKSIMAR_PLATFORM"
TOOLS_DIR="$ROOT/tools"
RUNTIME_STATE_DIR="$ROOT/RUNTIME/state"
LOGS_DIR="$ROOT/logs"
MODEL_READINESS_FILE="$RUNTIME_STATE_DIR/model_readiness.json"

RUNTIME_HEARTBEAT_FILE="$RUNTIME_STATE_DIR/heartbeat_state.json"
GUARD_HEARTBEAT_FILE="$RUNTIME_STATE_DIR/guard_heartbeat_state.json"
CORE_GUARD_HEARTBEAT_FILE="$RUNTIME_STATE_DIR/core_guard_heartbeat_state.json"
KERNEL_HEARTBEAT_FILE="$RUNTIME_STATE_DIR/kernel_heartbeat_state.json"
PREFLIGHT_RESULT_FILE="$RUNTIME_STATE_DIR/preflight_result.json"

DASHBOARD_SESSION="maksimar_dashboard"
DASHBOARD_OWNERSHIP_FILE="$RUNTIME_STATE_DIR/dashboard_session_ownership.env"

GUARD_LOG_FILE="$ROOT/logs/guard.log"
CORE_GUARD_LOG_FILE="$ROOT/logs/core_guard.log"
KERNEL_GUARD_LOG_FILE="$ROOT/logs/kernel_guard.log"

CANONICAL_PYTHON=""
if [[ -x "$ROOT/.venv/bin/python" ]]; then
  CANONICAL_PYTHON="$ROOT/.venv/bin/python"
elif [[ -x "$ROOT/venv/bin/python" ]]; then
  CANONICAL_PYTHON="$ROOT/venv/bin/python"
else
  echo "[work] ERROR: canonical python not found in .venv/bin/python or venv/bin/python"
  exit 1
fi

log() {
  echo "[work] $1"
}

abort() {
  local reason="$1"
  log "ERROR: $reason"
  "$TOOLS_DIR/rest" || true
  exit 1
}

wait_for_file() {
  local file_path="$1"
  local label="$2"
  local timeout_sec="$3"

  local started_at
  started_at="$(date +%s)"

  while true; do
    if [[ -f "$file_path" ]]; then
      log "$label file detected: $file_path"
      return 0
    fi

    local now
    now="$(date +%s)"
    if (( now - started_at >= timeout_sec )); then
      log "timeout waiting for $label file: $file_path"
      return 1
    fi

    sleep 1
  done
}

session_exists() {
  local session_name="$1"
  tmux has-session -t "$session_name" 2>/dev/null
}

remove_disposable_runtime_artifacts() {
  log "removing disposable runtime artifacts"
  mkdir -p "$RUNTIME_STATE_DIR" "$LOGS_DIR"

  rm -f \
    "$RUNTIME_HEARTBEAT_FILE" \
    "$GUARD_HEARTBEAT_FILE" \
    "$CORE_GUARD_HEARTBEAT_FILE" \
    "$KERNEL_HEARTBEAT_FILE"
}

run_preflight() {
  log "running runtime preflight"
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" \
    "$CANONICAL_PYTHON" "$ROOT/SUPERVISOR/runtime_preflight.py" || return 1

  if [[ ! -f "$PREFLIGHT_RESULT_FILE" ]]; then
    log "preflight result file not found: $PREFLIGHT_RESULT_FILE"
    return 1
  fi

  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" \
    "$CANONICAL_PYTHON" - <<'PY'
import json
from pathlib import Path

path = Path.home() / "MAKSIMAR_PLATFORM" / "RUNTIME" / "state" / "preflight_result.json"
data = json.loads(path.read_text(encoding="utf-8"))
if not data.get("ok", False):
    raise SystemExit(1)
print("[work] preflight result ok=true")
PY
}

preflight_reports_healthy_runtime() {
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" \
    "$CANONICAL_PYTHON" - "$PREFLIGHT_RESULT_FILE" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
data = json.loads(path.read_text(encoding="utf-8"))
raise SystemExit(0 if data.get("already_running_healthy") is True else 1)
PY
}

print_preflight_classification() {
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" \
    "$CANONICAL_PYTHON" - "$PREFLIGHT_RESULT_FILE" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
if not path.exists():
    print("[work] runtime classification unavailable: preflight result missing")
    raise SystemExit(0)
data = json.loads(path.read_text(encoding="utf-8"))
state = data.get("details", {}).get("runtime_state", {})
print(f"[work] runtime classification={state.get('classification', 'unknown')}")
for reason in state.get("reasons", []):
    print(f"[work]   reason={reason}")
PY
}

start_oob_dashboard() {
  log "starting independent OOB dashboard first..."
  "$TOOLS_DIR/oob_dashboard_ctl" start || true
  "$TOOLS_DIR/oob_dashboard_ctl" status || true
}

start_runtime() {
  log "starting runtime..."
  "$TOOLS_DIR/ctl" start
  "$TOOLS_DIR/ctl" status
}

wait_for_runtime_readiness() {
  log "waiting for runtime readiness..."
  wait_for_file "$RUNTIME_HEARTBEAT_FILE" "runtime heartbeat" 20 || return 1
}

wait_for_control_plane_health() {
  log "waiting for control-plane health before model warmup..."
  local started_at now
  started_at="$(date +%s)"
  while true; do
    if curl --silent --show-error --fail --max-time 2 http://127.0.0.1:8000/health >/dev/null 2>&1; then
      return 0
    fi
    now="$(date +%s)"
    if (( now - started_at >= 60 )); then
      log "timeout waiting for control-plane health"
      return 1
    fi
    sleep 1
  done
}


start_guard() {
  log "starting supervisor guard..."
  "$TOOLS_DIR/guard_ctl" start
  "$TOOLS_DIR/guard_ctl" status
}

start_core_guard() {
  log "starting core guard..."
  "$TOOLS_DIR/core_guard_ctl" start
  "$TOOLS_DIR/core_guard_ctl" status
}

start_kernel_watchdog() {
  log "starting kernel watchdog..."
  "$TOOLS_DIR/kernel_guard_ctl" start
  "$TOOLS_DIR/kernel_guard_ctl" status
}

wait_for_guard_chain() {
  local started_at now
  started_at="$(date +%s)"
  while true; do
    if PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" "$CANONICAL_PYTHON" -c \
      'from SUPERVISOR.runtime_preflight import inspect_runtime_state; raise SystemExit(0 if inspect_runtime_state()["decision"]["healthy"] is True else 1)'; then
      return 0
    fi
    now="$(date +%s)"
    if (( now - started_at >= 15 )); then
      log "timeout waiting for complete current-run guard chain"
      return 1
    fi
    sleep 1
  done
}

open_dashboard_windows() {
  log "opening session-bound dashboard windows after sessions exist..."
  "$TOOLS_DIR/dashboards_open" || return 1
  "$TOOLS_DIR/dashboard" status || true
}

register_dashboard_ownership() {
  printf '%s\n' \
    'owner=jarvis_runtime_dashboard' \
    "tmux_session=$DASHBOARD_SESSION" \
    'windows_terminal_window=JARVIS_RUNTIME_DASHBOARDS' \
    'operator_shell_owned=false' \
    'codex_session_owned=false' \
    > "$DASHBOARD_OWNERSHIP_FILE"
}

create_runtime_dashboard_session() {
  log "creating runtime-owned dashboard session..."

  if session_exists "$DASHBOARD_SESSION"; then
    log "dashboard session already exists; refusing to replace it: $DASHBOARD_SESSION"
    return 1
  fi

  tmux new-session -d -s "$DASHBOARD_SESSION" -n dashboard -c "$ROOT"

  local p_runtime p_cpu p_guard p_tree
  p_runtime="$(tmux display-message -p -t "$DASHBOARD_SESSION:dashboard.0" '#{pane_id}')"

  p_cpu="$(tmux split-window -h -t "$p_runtime" -l 50% -c "$ROOT" -P -F '#{pane_id}')"
  p_guard="$(tmux split-window -v -t "$p_runtime" -l 50% -c "$ROOT" -P -F '#{pane_id}')"
  p_tree="$(tmux split-window -v -t "$p_cpu" -l 50% -c "$ROOT" -P -F '#{pane_id}')"

  tmux send-keys -t "$p_runtime" \
    "cd '$ROOT' && watch -n1 './tools/ctl status'" C-m

  tmux send-keys -t "$p_cpu" \
    "cd '$ROOT' && exec btop" C-m

  tmux send-keys -t "$p_guard" \
    "cd '$ROOT' && touch '$GUARD_LOG_FILE' '$CORE_GUARD_LOG_FILE' '$KERNEL_GUARD_LOG_FILE' && bash -lc '(stdbuf -oL tail -n 0 -F \"$GUARD_LOG_FILE\" | sed -u \"s/^/[STOP-GATE] /\") & (stdbuf -oL tail -n 0 -F \"$CORE_GUARD_LOG_FILE\" | sed -u \"s/^/[CORE-GUARD] /\") & (stdbuf -oL tail -n 0 -F \"$KERNEL_GUARD_LOG_FILE\" | sed -u \"s/^/[KERNEL-WATCHDOG] /\") & wait'" C-m

  tmux send-keys -t "$p_tree" \
    "cd '$ROOT' && watch -n2 'tree -L 2 \"$ROOT\" | sed -n \"1,80p\"'" C-m

  tmux select-window -t "$DASHBOARD_SESSION:dashboard"
  tmux select-pane -t "$p_runtime"
  register_dashboard_ownership

  log "runtime dashboard session ready"
}

print_truth_summary() {
  log "truth summary:"
  [[ -f "$PREFLIGHT_RESULT_FILE" ]] && log "  preflight_result.json present"
  [[ -f "$RUNTIME_HEARTBEAT_FILE" ]] && log "  runtime heartbeat present"
  [[ -f "$GUARD_HEARTBEAT_FILE" ]] && log "  guard heartbeat present"
  [[ -f "$CORE_GUARD_HEARTBEAT_FILE" ]] && log "  core guard heartbeat present"
  [[ -f "$KERNEL_HEARTBEAT_FILE" ]] && log "  kernel heartbeat present"
}

recover_previous_run_degradation() {
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" "$CANONICAL_PYTHON" -c \
    'from CORE_ROOT.stop_gate import recover_previous_run_degradation; raise SystemExit(0 if recover_previous_run_degradation() else 1)' \
    || log "degradation remains active: current-run incident or incomplete recovery evidence"
}

main() {
  mkdir -p "$RUNTIME_STATE_DIR" "$LOGS_DIR"

  if ! run_preflight; then
    print_preflight_classification
    log "preflight rejected startup; existing runtime/processes were not stopped"
    exit 1
  fi

  if preflight_reports_healthy_runtime; then
    log "already running / healthy"
    recover_previous_run_degradation
    print_truth_summary
    exit 0
  fi

  remove_disposable_runtime_artifacts

  # Observer layers start only after preflight confirms a clean start.
  start_oob_dashboard
  create_runtime_dashboard_session || abort "runtime dashboard session failed"

  # open visibility immediately
  "$TOOLS_DIR/ui_open" || true

  start_runtime || abort "runtime start failed"
  wait_for_runtime_readiness || abort "runtime readiness timeout"
  wait_for_control_plane_health || abort "control-plane health timeout"
  # Initial tmux launch can precede supervisor discovery; reconcile only after
  # real HTTP readiness, through the same idempotent lifecycle owner.
  "$TOOLS_DIR/ctl" start || abort "runtime identity reconciliation failed"

  start_guard || abort "guard start failed"
  start_core_guard || abort "core guard start failed"
  start_kernel_watchdog || abort "kernel watchdog start failed"

  wait_for_guard_chain || abort "guard chain heartbeat timeout"
  recover_previous_run_degradation

  open_dashboard_windows || abort "dashboard windows open failed"

  print_truth_summary
  log "done"
}

main "$@"
