#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/MAKSIMAR_PLATFORM"
TOOLS_DIR="$ROOT/tools"
RUNTIME_STATE_DIR="$ROOT/RUNTIME/state"

RUNTIME_HEARTBEAT_FILE="$RUNTIME_STATE_DIR/heartbeat_state.json"
GUARD_HEARTBEAT_FILE="$RUNTIME_STATE_DIR/guard_heartbeat_state.json"
CORE_GUARD_HEARTBEAT_FILE="$RUNTIME_STATE_DIR/core_guard_heartbeat_state.json"
KERNEL_HEARTBEAT_FILE="$RUNTIME_STATE_DIR/kernel_heartbeat_state.json"
PREFLIGHT_RESULT_FILE="$RUNTIME_STATE_DIR/preflight_result.json"

DASHBOARD_SESSION="maksimar_dashboard"
DASHBOARD_OWNERSHIP_FILE="$RUNTIME_STATE_DIR/dashboard_session_ownership.env"

CANONICAL_PYTHON=""
if [[ -x "$ROOT/.venv/bin/python" ]]; then
  CANONICAL_PYTHON="$ROOT/.venv/bin/python"
elif [[ -x "$ROOT/venv/bin/python" ]]; then
  CANONICAL_PYTHON="$ROOT/venv/bin/python"
else
  echo "[rest] canonical python unavailable; stop incomplete"
  exit 1
fi

log() {
  echo "[rest] $1"
}

session_exists() {
  local session_name="$1"
  tmux has-session -t "$session_name" 2>/dev/null
}

remove_stale_state_files() {
  # Leave receipts/temporary evidence intact. Next canonical pre-start owns
  # verified archival/reconciliation; STOP is not a stale cleanup authority.
  log "retaining runtime receipts and temporary evidence for canonical pre-start"
}

close_dashboard_windows() {
  log "closing dashboard windows..."
  "$TOOLS_DIR/dashboard" close || true
}

dashboard_ownership_is_exact() {
  [[ -f "$DASHBOARD_OWNERSHIP_FILE" ]] \
    && grep -qx 'owner=jarvis_runtime_dashboard' "$DASHBOARD_OWNERSHIP_FILE" \
    && grep -qx "tmux_session=$DASHBOARD_SESSION" "$DASHBOARD_OWNERSHIP_FILE" \
    && grep -qx 'operator_shell_owned=false' "$DASHBOARD_OWNERSHIP_FILE" \
    && grep -qx 'codex_session_owned=false' "$DASHBOARD_OWNERSHIP_FILE"
}

stop_runtime_dashboard_session() {
  log "stopping registered runtime dashboard session..."
  if dashboard_ownership_is_exact && session_exists "$DASHBOARD_SESSION"; then
    tmux kill-session -t "$DASHBOARD_SESSION" 2>/dev/null || true
  elif session_exists "$DASHBOARD_SESSION"; then
    log "dashboard session is not registered as owned; leaving it untouched"
  fi
  rm -f "$DASHBOARD_OWNERSHIP_FILE"
  log "registered runtime dashboard cleanup complete"
}

reserve_lifecycle() {
  mkdir -p "$ROOT/RUNTIME/state"
  if [[ "${MAKSIMAR_STARTUP_FD:-}" != 8 ]]; then
    exec 8>>"$ROOT/RUNTIME/state/startup_reservation.lock"
    flock -n 8 || { log "another canonical startup/stop owns the reservation; incomplete"; return 1; }
    export MAKSIMAR_STARTUP_FD=8
  fi
  # The environment is not proof: verify the actual canonical inode/lock FD.
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" "$CANONICAL_PYTHON" - <<'PY'
from CORE_ROOT.run_context import startup_reservation
with startup_reservation():
    pass
PY
}

main() {
  reserve_lifecycle || return 1
  local expected_run
  expected_run="$(PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" "$CANONICAL_PYTHON" "$ROOT/SUPERVISOR/runtime_preflight.py" --capture-stop-run)" || { log "stop run identity unavailable; incomplete"; return 1; }
  log "stopping kernel watchdog..."
  "$TOOLS_DIR/kernel_guard_ctl" stop || { log "kernel_guard_ctl stop incomplete; retained diagnostics"; return 1; }

  log "stopping core guard..."
  "$TOOLS_DIR/core_guard_ctl" stop || { log "core_guard_ctl stop incomplete; retained diagnostics"; return 1; }

  log "stopping supervisor guard..."
  "$TOOLS_DIR/guard_ctl" stop || { log "guard_ctl stop incomplete; retained diagnostics"; return 1; }

  log "stopping runtime..."
  "$TOOLS_DIR/ctl" stop || { log "runtime stop incomplete; retained diagnostics"; return 1; }

  remove_stale_state_files

  log "stopping OOB dashboard last..."
  "$TOOLS_DIR/oob_dashboard_ctl" stop || true

  close_dashboard_windows
  stop_runtime_dashboard_session

  # This query writes no receipts, reports or reconciliation state.
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" "$CANONICAL_PYTHON" "$ROOT/SUPERVISOR/runtime_preflight.py" --verify-current-stop "$expected_run" || { log "independent stop readback incomplete; evidence retained"; return 1; }
  log "done"
}

main "$@"
