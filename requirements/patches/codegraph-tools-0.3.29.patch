+@lru_cache(maxsize=8192)
+def _source_root(parent: Path) -> Path:
+    for candidate in (parent, *parent.parents):
+        if (candidate / ".git").exists():
+            return candidate
+    cwd = Path.cwd().resolve()
+    return cwd if parent.is_relative_to(cwd) else Path(parent.anchor)
+
+
+def _source_key(path: Path) -> str:
+    """Canonical project-relative source identity, independent of invocation spelling."""
+    resolved = path.resolve()
+    return resolved.relative_to(_source_root(resolved.parent)).as_posix()
+
